### Лабораторная работа №2 - DTO и JSON
### Запустите lab2/src/main/java/view/WebAppServer.java (порт 8092).
@host = http://localhost:8092

### Все новости (ответ - JSON-объект NewsListDTO)
GET {{host}}/reader/news/all

### Одна новость (ответ - JSON-объект NewsItemDTO)
GET {{host}}/reader/news/1

### Новости за последнюю неделю
GET {{host}}/reader/news/last_week

### Поиск по ключевым словам
GET {{host}}/reader/news/search?keywords=метро

### Новости региона
GET {{host}}/reader/news/region?region=Москва

### Категории (CategoryListDTO)
GET {{host}}/reader/categories

### Оставить комментарий (CreateCommentRequestDTO -> CommentDTO)
POST {{host}}/reader/comments
Content-Type: application/json

{
  "newsId": 1,
  "author": "Иван",
  "text": "Очень полезная новость"
}

### Редактировать комментарий
PUT {{host}}/reader/comments/1
Content-Type: application/json

{
  "text": "Исправленный текст комментария"
}

### Удалить комментарий
DELETE {{host}}/reader/comments/1

### ===== API создателя =====

### Создать новость (CreateNewsRequestDTO -> NewsItemDTO)
POST {{host}}/creator/news
Content-Type: application/json

{
  "title": "Новая новость",
  "annotation": "Краткое описание",
  "text": "Полный текст новости",
  "categoryId": 1,
  "author": "Редакция",
  "region": "Москва",
  "tags": ["новости", "город"]
}

### Изменить новость
PUT {{host}}/creator/news/1
Content-Type: application/json

{
  "title": "Обновлённый заголовок",
  "text": "Обновлённый текст"
}

### Удалить новость
DELETE {{host}}/creator/news/1
